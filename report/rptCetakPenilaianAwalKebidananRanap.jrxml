                penilaian_awal_keperawatan_kebidanan_ranap_ranap.skrining_gizi_diketahui_dietisen,penilaian_awal_keperawatan_kebidanan_ranap_ranap.skrining_gizi_jam_diketahui_dietisen,penilaian_awal_keperawatan_kebidanan_ranap_ranap.informasi_perencanaan_pulang,penilaian_awal_keperawatan_kebidanan_ranap_ranap.kondisi_klinis_pulang,penilaian_awal_keperawatan_kebidanan_ranap_ranap.lama_ratarata,penilaian_awal_keperawatan_kebidanan_ranap_ranap.perencanaan_pulang,penilaian_awal_keperawatan_kebidanan_ranap_ranap.perawatan_lanjutan_dirumah,penilaian_awal_keperawatan_kebidanan_ranap_ranap.cara_transportasi_pulang,penilaian_awal_keperawatan_kebidanan_ranap_ranap.transportasi_digunakan,penilaian_awal_keperawatan_kebidanan_ranap_ranap.masalah,
                penilaian_awal_keperawatan_kebidanan_ranap_ranap.rencana,penilaian_awal_keperawatan_kebidanan_ranap_ranap.nip1,penilaian_awal_keperawatan_kebidanan_ranap_ranap.nip2,penilaian_awal_keperawatan_kebidanan_ranap_ranap.kd_dokter, 
                pasien.tgl_lahir,pasien.jk,pengkaji1.nama as pengkaji1,pengkaji2.nama as pengkaji2,dokter.nm_dokter,reg_periksa.no_rkm_medis,pasien.nm_pasien,pasien.agama,pasien.pekerjaan,pasien.pnd,penjab.png_jawab 
                from reg_periksa inner join pasien on reg_periksa.no_rkm_medis=pasien.no_rkm_medis 
                inner join penilaian_awal_keperawatan_kebidanan_ranap_ranap on reg_periksa.no_rawat=penilaian_awal_keperawatan_kebidanan_ranap_ranap.no_rawat 
                inner join petugas as pengkaji1 on penilaian_awal_keperawatan_kebidanan_ranap_ranap.nip1=pengkaji1.nip 
                inner join petugas as pengkaji2 on penilaian_awal_keperawatan_kebidanan_ranap_ranap.nip2=pengkaji2.nip 
                inner join dokter on penilaian_awal_keperawatan_kebidanan_ranap_ranap.kd_dokter=dokter.kd_dokter 
                inner join bahasa_pasien on bahasa_pasien.id=pasien.bahasa_pasien 
                inner join penjab on penjab.kd_pj=reg_periksa.kd_pj]]>
	</queryString>
